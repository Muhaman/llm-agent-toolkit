{
  "name": "llm-agent-toolkit",
  "version": "0.1.0",
  "description": "A minimal, framework-free agent runtime for Claude: typed tools, parallel calls, budgets and approvals.",
  "license": "MIT",
  "author": "Muhamman Ahmad",
  "type": "module",
  "engines": { "node": ">=24" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": { "agent": "./dist/cli.js" },
  "files": ["dist"],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.0",
    "eslint": "^10.13.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.0"
  }
}
